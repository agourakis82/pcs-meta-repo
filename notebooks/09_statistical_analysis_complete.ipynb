 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# SWOW+KEC+EEG+RT Statistical Analysis\n",
    "\n",
    "**Author:** PCS Meta-Repo Team  \n",
    "**Date:** January 2025  \n",
    "**Version:** 1.0.0  \n",
    "\n",
    "## Overview\n",
    "\n",
    "Advanced statistical analysis of integrated SWOW+KEC+EEG+RT data including:\n",
    "- Mixed-effects linear models\n",
    "- FDR correction for multiple comparisons\n",
    "- Bootstrap confidence intervals\n",
    "- Publication-quality figures"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import libraries\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy import stats\n",
    "from scipy.stats import pearsonr\n",
    "import statsmodels.api as sm\n",
    "import statsmodels.formula.api as smf\n",
    "from statsmodels.stats.multitest import multipletests\n",
    "from pathlib import Path\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Set seeds\n",
    "np.random.seed(42)\n",
    "import random\n",
    "random.seed(42)\n",
    "\n",
    "print(\"Libraries imported successfully\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Setup paths and load data\n",
    "ROOT = Path('.')\n",
    "OUTPUTS = ROOT / 'outputs' / 'integration'\n",
    "FIGURES = ROOT / 'figures' / 'statistical_analysis'\n",
    "REPORTS = ROOT / 'reports' / 'statistical_analysis'\n",
    "\n",
    "# Create directories\n",
    "FIGURES.mkdir(parents=True, exist_ok=True)\n",
    "REPORTS.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Load integrated data\n",
    "data_file = OUTPUTS / 'integrated_swow_kec_eeg_rt.csv'\n",
    "if data_file.exists():\n",
    "    df = pd.read_csv(data_file)\n",
    "    print(f\"Loaded integrated dataset: {len(df):,} records\")\n",
    "else:\n",
    "    print(\"Creating synthetic dataset for demonstration\")\n",
    "    n = 5000\n",
    "    df = pd.DataFrame({\n",
    "        'subject_id': np.random.choice(['S01', 'S02', 'S03', 'S04', 'S05'], n),\n",
    "        'token_norm': [f'word{i}' for i in range(n)],\n",
    "        'entropy': np.random.exponential(2.0, n),\n",
    "        'curvature': np.random.normal(0, 1, n),\n",
    "        'coherence': np.random.uniform(-1, 1, n),\n",
    "        'ffd_ms': np.random.exponential(200, n),\n",
    "        'gd_ms': np.random.exponential(250, n),\n",
    "        'trt_ms': np.random.exponential(300, n),\n",
    "        'theta': np.random.normal(0, 1, n),\n",
    "        'alpha': np.random.normal(0, 1, n),\n",
    "        'beta': np.random.normal(0, 1, n),\n",
    "        'gamma': np.random.normal(0, 1, n),\n",
    "        'dataset': np.random.choice(['zuco_v1', 'zuco_v2', 'derco'], n),\n",
    "        'language': np.random.choice(['en', 'es', 'zh', 'nl'], n)\n",
    "    })\n",
    "\n",
    "print(f\"Dataset shape: {df.shape}\")\n",
    "print(f\"Columns: {list(df.columns)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 1: Descriptive Statistics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Descriptive statistics\n",
    "print(\"=== DESCRIPTIVE STATISTICS ===\")\n",
    "\n",
    "# Define variable groups\n",
    "kec_vars = ['entropy', 'curvature', 'coherence']\n",
    "rt_vars = ['ffd_ms', 'gd_ms', 'trt_ms']\n",
    "eeg_vars = ['theta', 'alpha', 'beta', 'gamma']\n",
    "\n",
    "# Filter to available variables\n",
    "available_kec = [v for v in kec_vars if v in df.columns]\n",
    "available_rt = [v for v in rt_vars if v in df.columns]\n",
    "available_eeg = [v for v in eeg_vars if v in df.columns]\n",
    "\n",
    "print(f\"Available KEC variables: {available_kec}\")\n",
    "print(f\"Available RT variables: {available_rt}\")\n",
    "print(f\"Available EEG variables: {available_eeg}\")\n",
    "\n",
    "# Complete cases analysis\n",
    "complete_kec_rt = df.dropna(subset=available_kec + available_rt[:1])\n",
    "print(f\"\\nComplete cases (KEC + RT): {len(complete_kec_rt):,} ({len(complete_kec_rt)/len(df):.1%})\")\n",
    "\n",
    "# Summary statistics\n",
    "if available_kec:\n",
    "    print(\"\\nKEC Metrics Summary:\")\n",
    "    print(df[available_kec].describe().round(3))\n",
    "\n",
    "if available_rt:\n",
    "    print(\"\\nReading Time Summary:\")\n",
    "    print(df[available_rt].describe().round(3))\n",
    "\n",
    "if available_eeg:\n",
    "    print(\"\\nEEG Summary:\")\n",
    "    print(df[available_eeg].describe().round(3))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 2: Correlation Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Correlation analysis\n",
    "print(\"=== CORRELATION ANALYSIS ===\")\n",
    "\n",
    "correlation_results = []\n",
    "\n",
    "# KEC vs Reading Time correlations\n",
    "if available_kec and available_rt:\n",
    "    print(\"\\nKEC vs Reading Time Correlations:\")\n",
    "    for kec_var in available_kec:\n",
    "        for rt_var in available_rt:\n",
    "            subset = df[[kec_var, rt_var]].dropna()\n",
    "            if len(subset) > 10:\n",
    "                r, p = pearsonr(subset[kec_var], subset[rt_var])\n",
    "                correlation_results.append({\n",
    "                    'var1': kec_var,\n",
    "                    'var2': rt_var,\n",
    "                    'r': r,\n",
    "                    'p': p,\n",
    "                    'n': len(subset),\n",
    "                    'type': 'KEC_RT'\n",
    "                })\n",
    "                print(f\"  {kec_var} × {rt_var}: r = {r:.3f}, p = {p:.3f}, n = {len(subset)}\")\n",
    "\n",
    "# KEC vs EEG correlations\n",
    "if available_kec and available_eeg:\n",
    "    print(\"\\nKEC vs EEG Correlations:\")\n",
    "    for kec_var in available_kec:\n",
    "        for eeg_var in available_eeg:\n",
    "            subset = df[[kec_var, eeg_var]].dropna()\n",
    "            if len(subset) > 10:\n",
    "                r, p = pearsonr(subset[kec_var], subset[eeg_var])\n",
    "                correlation_results.append({\n",
    "                    'var1': kec_var,\n",
    "                    'var2': eeg_var,\n",
    "                    'r': r,\n",
    "                    'p': p,\n",
    "                    'n': len(subset),\n",
    "                    'type': 'KEC_EEG'\n",
    "                })\n",
    "                print(f\"  {kec_var} × {eeg_var}: r = {r:.3f}, p = {p:.3f}, n = {len(subset)}\")\n",
    "\n",
    "# Convert to DataFrame\n",
    "if correlation_results:\n",
    "    corr_df = pd.DataFrame(correlation_results)\n",
    "    print(f\"\\nTotal correlations computed: {len(corr_df)}\")\n",
    "else:\n",
    "    corr_df = pd.DataFrame()\n",
    "    print(\"No correlations computed\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 3: Linear Models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Linear regression models\n",
    "print(\"=== LINEAR REGRESSION MODELS ===\")\n",
    "\n",
    "model_results = []\n",
    "\n",
    "# Models for Reading Time outcomes\n",
    "if available_kec and available_rt:\n",
    "    print(\"\\nReading Time Models:\")\n",
    "    \n",
    "    for outcome in available_rt:\n",
    "        # Prepare data\n",
    "        model_vars = [outcome] + available_kec\n",
    "        model_data = df[model_vars].dropna()\n",
    "        \n",
    "        if len(model_data) < 50:\n",
    "            print(f\"  Insufficient data for {outcome}: {len(model_data)} cases\")\n",
    "            continue\n",
    "        \n",
    "        # Log-transform outcome (common for RT data)\n",
    "        model_data[f'log_{outcome}'] = np.log1p(model_data[outcome])\n",
    "        \n",
    "        # Fit model\n",
    "        predictors_str = ' + '.join(available_kec)\n",
    "        formula = f'log_{outcome} ~ {predictors_str}'\n",
    "        \n",
    "        try:\n",
    "            model = smf.ols(formula, data=model_data)\n",
    "            result = model.fit()\n",
    "            \n",
    "            # Extract coefficients\n",
    "            for predictor in available_kec:\n",
    "                if predictor in result.params.index:\n",
    "                    coef = result.params[predictor]\n",
    "                    se = result.bse[predictor]\n",
    "                    pval = result.pvalues[predictor]\n",
    "                    \n",
    "                    model_results.append({\n",
    "                        'outcome': outcome,\n",
    "                        'predictor': predictor,\n",
    "                        'coefficient': coef,\n",
    "                        'se': se,\n",
    "                        'p_value': pval,\n",
    "                        'n_obs': len(model_data),\n",
    "                        'r_squared': result.rsquared,\n",
    "                        'outcome_type': 'RT'\n",
    "                    })\n",
    "            \n",
    "            print(f\"  {outcome}: R² = {result.rsquared:.3f}, n = {len(model_data)}\")\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"  Failed to fit model for {outcome}: {e}\")\n",
    "\n",
    "# Models for EEG outcomes\n",
    "if available_kec and available_eeg:\n",
    "    print(\"\\nEEG Models:\")\n",
    "    \n",
    "    for outcome in available_eeg:\n",
    "        model_vars = [outcome] + available_kec\n",
    "        model_data = df[model_vars].dropna()\n",
    "        \n",
    "        if len(model_data) < 50:\n",
    "            print(f\"  Insufficient data for {outcome}: {len(model_data)} cases\")\n",
    "            continue\n",
    "        \n",
    "        # Fit model\n",
    "        predictors_str = ' + '.join(available_kec)\n",
    "        formula = f'{outcome} ~ {predictors_str}'\n",
    "        \n",
    "        try:\n",
    "            model = smf.ols(formula, data=model_data)\n",
    "            result = model.fit()\n",
    "            \n",
    "            # Extract coefficients\n",
    "            for predictor in available_kec:\n",
    "                if predictor in result.params.index:\n",
    "                    coef = result.params[predictor]\n",
    "                    se = result.bse[predictor]\n",
    "                    pval = result.pvalues[predictor]\n",
    "                    \n",
    "                    model_results.append({\n",
    "                        'outcome': outcome,\n",
    "                        'predictor': predictor,\n",
    "                        'coefficient': coef,\n",
    "                        'se': se,\n",
    "                        'p_value': pval,\n",
    "                        'n_obs': len(model_data),\n",
    "                        'r_squared': result.rsquared,\n",
    "                        'outcome_type': 'EEG'\n",
    "                    })\n",
    "            \n",
    "            print(f\"  {outcome}: R² = {result.rsquared:.3f}, n = {len(model_data)}\")\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"  Failed to fit model for {outcome}: {e}\")\n",
    "\n",
    "# Convert to DataFrame\n",
    "if model_results:\n",
    "    results_df = pd.DataFrame(model_results)\n",
    "    print(f\"\\nTotal model coefficients: {len(results_df)}\")\n",
    "else:\n",
    "    results_df = pd.DataFrame()\n",
    "    print(\"No model results\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 4: Multiple Comparisons Correction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# FDR correction\n",
    "print(\"=== FDR CORRECTION ===\")\n",
    "\n",
    "if len(results_df) > 0 and 'p_value' in results_df.columns:\n",
    "    # Apply Benjamini-Hochberg FDR correction\n",
    "    p_values = results_df['p_value'].values\n",
    "    valid_p = ~np.isnan(p_values)\n",
    "    \n",
    "    if valid_p.sum() > 0:\n",
    "        rejected, p_corrected, alpha_sidak, alpha_bonf = multipletests(\n",
    "            p_values[valid_p], \n",
    "            alpha=0.05, \n",
    "            method='fdr_bh'\n",
    "        )\n",
    "        \n",
    "        # Add corrected p-values to results\n",
    "        results_df['p_fdr'] = np.nan\n",
    "        results_df['significant_fdr'] = False\n",
    "        \n",
    "        results_df.loc[valid_p, 'p_fdr'] = p_corrected\n",
    "        results_df.loc[valid_p, 'significant_fdr'] = rejected\n",
    "        \n",
    "        # Summary\n",
    "        n_tests = valid_p.sum()\n",
    "        n_significant = rejected.sum()\n",
    "        \n",
    "        print(f\"Total tests: {n_tests}\")\n",
    "        print(f\"Significant after FDR correction: {n_significant} ({n_significant/n_tests:.1%})\")\n",
    "        \n",
    "        # Show significant results\n",
    "        if n_significant > 0:\n",
    "            sig_results = results_df[results_df['significant_fdr']]\n",
    "            print(\"\\nSignificant effects (FDR corrected):\")\n",
    "            for _, row in sig_results.iterrows():\n",
    "                print(f\"  {row['predictor']} → {row['outcome']}: β = {row['coefficient']:.3f}, p_FDR = {row['p_fdr']:.3f}\")\n",
    "        else:\n",
    "            print(\"\\nNo significant effects after FDR correction\")\n",
    "    else:\n",
    "        print(\"No valid p-values for correction\")\n",
    "else:\n",
    "    print(\"No model results available for FDR correction\")"
   ]
  },
  {
