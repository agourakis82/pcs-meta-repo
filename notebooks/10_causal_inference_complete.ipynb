    "## 4. Causal Effect Estimation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to estimate causal effects using DoWhy\n",
    "def estimate_causal_effect(data, treatment, outcome, confounders, graph=None):\n",
    "    \"\"\"\n",
    "    Estimate causal effect using multiple identification and estimation methods\n",
    "    \"\"\"\n",
    "    results = {}\n",
    "    \n",
    "    try:\n",
    "        # Create causal model\n",
    "        model = CausalModel(\n",
    "            data=data,\n",
    "            treatment=treatment,\n",
    "            outcome=outcome,\n",
    "            common_causes=confounders,\n",
    "            graph=graph\n",
    "        )\n",
    "        \n",
    "        # Identify causal effect\n",
    "        identified_estimand = model.identify_effect(proceed_when_unidentifiable=True)\n",
    "        \n",
    "        # Estimate using different methods\n",
    "        methods = [\n",
    "            \"backdoor.linear_regression\",\n",
    "            \"backdoor.propensity_score_matching\",\n",
    "            \"backdoor.propensity_score_weighting\"\n",
    "        ]\n",
    "        \n",
    "        for method in methods:\n",
    "            try:\n",
    "                estimate = model.estimate_effect(\n",
    "                    identified_estimand,\n",
    "                    method_name=method,\n",
    "                    confidence_intervals=True,\n",
    "                    test_significance=True\n",
    "                )\n",
    "                \n",
    "                results[method] = {\n",
    "                    'effect': estimate.value,\n",
    "                    'ci_lower': estimate.get_confidence_intervals()[0],\n",
    "                    'ci_upper': estimate.get_confidence_intervals()[1],\n",
    "                    'p_value': estimate.test_stat_significance()['p_value']\n",
    "                }\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"Method {method} failed: {e}\")\n",
    "                continue\n",
    "        \n",
    "        # Refutation tests\n",
    "        refutation_results = {}\n",
    "        \n",
    "        # Random common cause\n",
    "        try:\n",
    "            refute_random = model.refute_estimate(\n",
    "                identified_estimand, estimate, \n",
    "                method_name=\"random_common_cause\"\n",
    "            )\n",
    "            refutation_results['random_common_cause'] = refute_random.new_effect\n",
    "        except:\n",
    "            pass\n",
    "        \n",
    "        # Placebo treatment\n",
    "        try:\n",
    "            refute_placebo = model.refute_estimate(\n",
    "                identified_estimand, estimate,\n",
    "                method_name=\"placebo_treatment_refuter\"\n",
    "            )\n",
    "            refutation_results['placebo_treatment'] = refute_placebo.new_effect\n",
    "        except:\n",
    "            pass\n",
    "        \n",
    "        results['refutations'] = refutation_results\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"DoWhy analysis failed: {e}\")\n",
    "        # Fallback to simple regression\n",
    "        X = data[confounders + [treatment]]\n",
    "        y = data[outcome]\n",
    "        \n",
    "        model_lr = LinearRegression().fit(X, y)\n",
    "        treatment_idx = list(X.columns).index(treatment)\n",
    "        \n",
    "        results['linear_regression'] = {\n",
    "            'effect': model_lr.coef_[treatment_idx],\n",
    "            'ci_lower': None,\n",
    "            'ci_upper': None,\n",
    "            'p_value': None\n",
    "        }\n",
    "    \n",
    "    return results\n",
    "\n",
    "# Estimate causal effects for key relationships\n",
    "causal_effects = {}\n",
    "\n",
    "# Define analysis configurations\n",
    "analyses = [\n",
    "    {\n",
    "        'name': 'entropy_to_theta',\n",
    "        'treatment': 'kec_entropy',\n",
    "        'outcome': 'theta_power',\n",
    "        'confounders': ['word_frequency', 'word_length']\n",
    "    },\n",
    "    {\n",
    "        'name': 'theta_to_ffd',\n",
    "        'treatment': 'theta_power',\n",
    "        'outcome': 'first_fixation_duration',\n",
    "        'confounders': ['word_frequency', 'word_length', 'kec_entropy']\n",
    "    },\n",
    "    {\n",
    "        'name': 'entropy_to_ffd',\n",
    "        'treatment': 'kec_entropy',\n",
    "        'outcome': 'first_fixation_duration',\n",
    "        'confounders': ['word_frequency', 'word_length']\n",
    "    }\n",
    "]\n",
    "\n",
    "print(\"Estimating Causal Effects...\\n\")\n",
    "\n",
    "for analysis in analyses:\n",
    "    print(f\"Analysis: {analysis['name']}\")\n",
    "    print(f\"Treatment: {analysis['treatment']} → Outcome: {analysis['outcome']}\")\n",
    "    \n",
    "    # Clean data for this analysis\n",
    "    analysis_data = df[analysis['confounders'] + [analysis['treatment'], analysis['outcome']]].dropna()\n",
    "    \n",
    "    # Estimate effects\n",
    "    effects = estimate_causal_effect(\n",
    "        data=analysis_data,\n",
    "        treatment=analysis['treatment'],\n",
    "        outcome=analysis['outcome'],\n",
    "        confounders=analysis['confounders']\n",
    "    )\n",
    "    \n",
    "    causal_effects[analysis['name']] = effects\n",
    "    \n",
    "    # Display results\n",
    "    for method, result in effects.items():\n",
    "        if method != 'refutations' and result:\n",
    "            effect = result['effect']\n",
    "            ci_lower = result.get('ci_lower', 'N/A')\n",
    "            ci_upper = result.get('ci_upper', 'N/A')\n",
    "            p_value = result.get('p_value', 'N/A')\n",
    "            \n",
    "            print(f\"  {method}: Effect = {effect:.4f}, CI = [{ci_lower}, {ci_upper}], p = {p_value}\")\n",
    "    \n",
    "    print(\"\\n\" + \"-\"*50 + \"\\n\")"
   ]
