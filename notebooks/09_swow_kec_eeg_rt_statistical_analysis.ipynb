    "def generate_descriptive_statistics(df):\n",
    "    \"\"\"Generate comprehensive descriptive statistics.\"\"\"\n",
    "    print(\"📊 Generating Descriptive Statistics...\")\n",
    "    \n",
    "    # Define variable groups\n",
    "    kec_vars = ['entropy', 'curvature', 'coherence']\n",
    "    rt_vars = ['ffd_ms', 'gd_ms', 'trt_ms']\n",
    "    eeg_vars = ['theta', 'alpha', 'beta', 'gamma']\n",
    "    \n",
    "    # Filter to complete cases for KEC analysis\n",
    "    complete_kec = df.dropna(subset=kec_vars + rt_vars[:1])  # At least one RT measure\n",
    "    print(f\"Complete cases for KEC analysis: {len(complete_kec):,} ({len(complete_kec)/len(df):.1%})\")\n",
    "    \n",
    "    # Descriptive statistics by variable group\n",
    "    stats_summary = {}\n",
    "    \n",
    "    for var_group, vars_list in [('KEC', kec_vars), ('Reading Time', rt_vars), ('EEG', eeg_vars)]:\n",
    "        available_vars = [v for v in vars_list if v in df.columns]\n",
    "        if available_vars:\n",
    "            subset = df[available_vars].dropna()\n",
    "            if len(subset) > 0:\n",
    "                stats_summary[var_group] = subset.describe()\n",
    "                print(f\"\\n{var_group} Variables ({len(subset):,} complete cases):\")\n",
    "                print(stats_summary[var_group].round(3))\n",
    "    \n",
    "    # Missing data analysis\n",
    "    print(\"\\n🔍 Missing Data Analysis:\")\n",
    "    missing_analysis = df.isnull().sum().sort_values(ascending=False)\n",
    "    missing_pct = (missing_analysis / len(df) * 100).round(1)\n",
    "    \n",
    "    for var, count in missing_analysis.head(10).items():\n",
    "        if count > 0:\n",
    "            print(f\"  {var}: {count:,} ({missing_pct[var]}%)\")\n",
    "    \n",
    "    # Data distribution by grouping variables\n",
    "    print(\"\\n📈 Data Distribution:\")\n",
    "    for group_var in ['language', 'dataset', 'subject_id']:\n",
    "        if group_var in df.columns:\n",
    "            counts = df[group_var].value_counts()\n",
    "            print(f\"\\n{group_var.title()}:\")\n",
    "            for val, count in counts.head(10).items():\n",
    "                pct = count / len(df) * 100\n",
    "                print(f\"  {val}: {count:,} ({pct:.1f}%)\")\n",
    "    \n",
    "    return stats_summary, complete_kec\n",
    "\n",
    "# Generate descriptive statistics\n",
    "stats_summary, complete_data = generate_descriptive_statistics(df)"
   ]
