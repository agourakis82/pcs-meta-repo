    "def fit_mixed_effects_models(df):\n",
    "    \"\"\"Fit mixed-effects linear models with KEC predictors.\"\"\"\n",
    "    print(\"🔬 Fitting Mixed-Effects Linear Models...\")\n",
    "    \n",
    "    # Define variables\n",
    "    kec_predictors = ['entropy', 'curvature', 'coherence']\n",
    "    rt_outcomes = ['ffd_ms', 'gd_ms', 'trt_ms']\n",
    "    eeg_outcomes = ['theta', 'alpha', 'beta', 'gamma']\n",
    "    \n",
    "    # Filter available variables\n",
    "    available_kec = [v for v in kec_predictors if v in df.columns and df[v].notna().sum() > 100]\n",
    "    available_rt = [v for v in rt_outcomes if v in df.columns and df[v].notna().sum() > 100]\n",
    "    available_eeg = [v for v in eeg_outcomes if v in df.columns and df[v].notna().sum() > 100]\n",
    "    \n",
    "    model_results = {}\n",
    "    \n",
    "    # Check if we have subject_id for random effects\n",
    "    has_subjects = 'subject_id' in df.columns and df['subject_id'].nunique() > 1\n",
    "    \n",
    "    print(f\"Available predictors: {available_kec}\")\n",
    "    print(f\"Available RT outcomes: {available_rt}\")\n",
    "    print(f\"Available EEG outcomes: {available_eeg}\")\n",
    "    print(f\"Random effects by subject: {has_subjects}\")\n",
    "    \n",
    "    # Fit models for Reading Time outcomes\n",
    "    if available_kec and available_rt:\n",
    "        print(\"\\n📊 Reading Time Models:\")\n",
    "        rt_results = []\n",
    "        \n",
    "        for outcome in available_rt:\n",
    "            # Prepare data\n",
    "            model_vars = [outcome] + available_kec\n",
    "            if has_subjects:\n",
    "                model_vars.append('subject_id')\n",
    "            \n",
    "            model_data = df[model_vars].dropna()\n",
    "            \n",
    "            if len(model_data) < 50:\n",
    "                print(f\"  ⚠️  Insufficient data for {outcome}: {len(model_data)} cases\")\n",
    "                continue\n",
    "            \n",
    "            # Log-transform RT variables (common in psycholinguistics)\n",
    "            model_data[f'log_{outcome}'] = np.log1p(model_data[outcome])\n",
    "            \n",
    "            # Create formula\n",
    "            predictors_str = ' + '.join(available_kec)\n",
    "            formula = f'log_{outcome} ~ {predictors_str}'\n",
    "            \n",
    "            try:\n",
    "                if has_subjects and model_data['subject_id'].nunique() > 1:\n",
    "                    # Mixed-effects model\n",
    "                    model = MixedLM.from_formula(formula, model_data, groups=model_data['subject_id'])\n",
    "                    result = model.fit(method='lbfgs')\n",
    "                    model_type = 'Mixed-Effects'\n",
    "                else:\n",
    "                    # OLS model\n",
    "                    model = smf.ols(formula, data=model_data)\n",
    "                    result = model.fit()\n",
    "                    model_type = 'OLS'\n",
    "                \n",
    "                # Extract results\n",
    "                for predictor in available_kec:\n",
    "                    if predictor in result.params.index:\n",
    "                        coef = result.params[predictor]\n",
    "                        se = result.bse[predictor] if hasattr(result, 'bse') else np.nan\n",
    "                        pval = result.pvalues[predictor] if hasattr(result, 'pvalues') else np.nan\n",
    "                        \n",
    "                        rt_results.append({\n",
    "                            'outcome': outcome,\n",
    "                            'predictor': predictor,\n",
    "                            'coefficient': coef,\n",
    "                            'se': se,\n",
    "                            'p_value': pval,\n",
    "                            'n_obs': len(model_data),\n",
    "                            'model_type': model_type\n",
    "                        })\n",
    "                \n",
    "                print(f\"  ✅ {outcome}: {model_type}, n = {len(model_data)}\")\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"  ❌ Failed to fit model for {outcome}: {e}\")\n",
    "        \n",
    "        if rt_results:\n",
    "            model_results['reading_time'] = pd.DataFrame(rt_results)\n",
    "    \n",
    "    # Fit models for EEG outcomes\n",
    "    if available_kec and available_eeg:\n",
    "        print(\"\\n🧠 EEG Models:\")\n",
    "        eeg_results = []\n",
    "        \n",
    "        for outcome in available_eeg:\n",
    "            model_vars = [outcome] + available_kec\n",
    "            if has_subjects:\n",
    "                model_vars.append('subject_id')\n",
    "            \n",
    "            model_data = df[model_vars].dropna()\n",
    "            \n",
    "            if len(model_data) < 50:\n",
    "                print(f\"  ⚠️  Insufficient data for {outcome}: {len(model_data)} cases\")\n",
    "                continue\n",
    "            \n",
    "            # Create formula\n",
    "            predictors_str = ' + '.join(available_kec)\n",
    "            formula = f'{outcome} ~ {predictors_str}'\n",
    "            \n",
    "            try:\n",
    "                if has_subjects and model_data['subject_id'].nunique() > 1:\n",
    "                    model = MixedLM.from_formula(formula, model_data, groups=model_data['subject_id'])\n",
    "                    result = model.fit(method='lbfgs')\n",
    "                    model_type = 'Mixed-Effects'\n",
    "                else:\n",
    "                    model = smf.ols(formula, data=model_data)\n",
    "                    result = model.fit()\n",
    "                    model_type = 'OLS'\n",
    "                \n",
    "                # Extract results\n",
    "                for predictor in available_kec:\n",
    "                    if predictor in result.params.index:\n",
    "                        coef = result.params[predictor]\n",
    "                        se = result.bse[predictor] if hasattr(result, 'bse') else np.nan\n",
    "                        pval = result.pvalues[predictor] if hasattr(result, 'pvalues') else np.nan\n",
    "                        \n",
    "                        eeg_results.append({\n",
    "                            'outcome': outcome,\n",
    "                            'predictor': predictor,\n",
    "                            'coefficient': coef,\n",
    "                            'se': se,\n",
    "                            'p_value': pval,\n",
    "                            'n_obs': len(model_data),\n",
    "                            'model_type': model_type\n",
    "                        })\n",
    "                \n",
    "                print(f\"  ✅ {outcome}: {model_type}, n = {len(model_data)}\")\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"  ❌ Failed to fit model for {outcome}: {e}\")\n",
    "        \n",
    "        if eeg_results:\n",
    "            model_results['eeg'] = pd.DataFrame(eeg_results)\n",
    "    \n",
    "    return model_results\n",
    "\n",
    "# Fit mixed-effects models\n",
    "model_results = fit_mixed_effects_models(complete_data)"
   ]
