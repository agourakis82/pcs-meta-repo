   "source": [
    "def apply_fdr_correction(model_results):\n",
    "    \"\"\"Apply False Discovery Rate correction to model results.\"\"\"\n",
    "    print(\"🔧 Applying FDR Correction...\")\n",
    "    \n",
    "    corrected_results = {}\n",
    "    \n",
    "    for outcome_type, results_df in model_results.items():\n",
    "        if 'p_value' in results_df.columns:\n",
    "            # Apply FDR correction\n",
    "            p_values = results_df['p_value'].values\n",
    "            valid_p = ~np.isnan(p_values)\n",
    "            \n",
    "            if valid_p.sum() > 0:\n",
    "                # Apply Benjamini-Hochberg correction\n",
    "                rejected, p_corrected, alpha_sidak, alpha_bonf = multipletests(\n",
    "                    p_values[valid_p], \n",
    "                    alpha=STAT_CONFIG['alpha'], \n",
    "                    method=STAT_CONFIG['fdr_method']\n",
    "                )\n",
    "                \n",
    "                # Create corrected results\n",
    "                results_corrected = results_df.copy()\n",
    "                results_corrected['p_fdr'] = np.nan\n",
    "                results_corrected['significant_fdr'] = False\n",
    "                \n",
    "                results_corrected.loc[valid_p, 'p_fdr'] = p_corrected\n",
    "                results_corrected.loc[valid_p, 'significant_fdr'] = rejected\n",
    "                \n",
    "                # Add effect size categories\n",
    "                results_corrected['effect_size'] = 'small'\n",
    "                results_corrected.loc[np.abs(results_corrected['coefficient']) > 0.3, 'effect_size'] = 'medium'\n",
    "                results_corrected.loc[np.abs(results_corrected['coefficient']) > 0.5, 'effect_size'] = 'large'\n",
    "                \n",
    "                corrected_results[outcome_type] = results_corrected\n",
    "                \n",
    "                # Summary\n",
    "                n_tests = valid_p.sum()\n",
    "                n_significant = rejected.sum()\n",
    "                print(f\"\\n{outcome_type.title()} Models:\")\n",
    "                print(f\"  Total tests: {n_tests}\")\n",
    "                print(f\"  Significant after FDR: {n_significant} ({n_significant/n_tests:.1%})\")\n",
    "                \n",
    "                # Show significant results\n",
    "                if n_significant > 0:\n",
    "                    sig_results = results_corrected[results_corrected['significant_fdr']]\n",
    "                    print(\"  Significant effects:\")\n",
    "                    for _, row in sig_results.iterrows():\n",
    "                        print(f\"    {row['predictor']} → {row['outcome']}: β = {row['coefficient']:.3f}, p_FDR = {row['p_fdr']:.3f}\")\n",
    "    \n",
    "    return corrected_results\n",
    "\n",
    "# Apply FDR correction\n",
    "if model_results:\n",
    "    corrected_results = apply_fdr_correction(model_results)\n",
    "else:\n",
    "    print(\"⚠️  No model results available for FDR correction\")\n",
    "    corrected_results = {}"
   ]
  },
