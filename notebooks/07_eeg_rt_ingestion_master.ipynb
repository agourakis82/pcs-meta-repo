    "def discover_datasets() -> Dict[str, Dict[str, Any]]:\n",
    "    \"\"\"\n",
    "    Discover available datasets by checking for expected files.\n",
    "    \n",
    "    Returns:\n",
    "        Dictionary with dataset availability information\n",
    "    \"\"\"\n",
    "    discovery_results = {}\n",
    "    \n",
    "    # Check data directories\n",
    "    data_dirs = [\n",
    "        DATA / 'raw_public',\n",
    "        DATA / 'raw_external', \n",
    "        Path.home() / 'FASTDATA' / 'raw_external',  # Alternative location\n",
    "    ]\n",
    "    \n",
    "    for dataset_id, config in DATASETS_CONFIG.items():\n",
    "        result = {\n",
    "            'available': False,\n",
    "            'files_found': [],\n",
    "            'data_dir': None,\n",
    "            'file_count': 0\n",
    "        }\n",
    "        \n",
    "        # Search for dataset files\n",
    "        for data_dir in data_dirs:\n",
    "            if not data_dir.exists():\n",
    "                continue\n",
    "                \n",
    "            # Look for dataset-specific subdirectories\n",
    "            potential_dirs = [\n",
    "                data_dir / dataset_id,\n",
    "                data_dir / dataset_id.upper(),\n",
    "                data_dir / config['name'].lower().replace(' ', '_')\n",
    "            ]\n",
    "            \n",
    "            # Special case for ZuCo\n",
    "            if dataset_id == 'zuco':\n",
    "                potential_dirs.extend([\n",
    "                    data_dir / 'zuco' / 'v1',\n",
    "                    data_dir / 'zuco' / 'v2'\n",
    "                ])\n",
    "            \n",
    "            for dataset_dir in potential_dirs:\n",
    "                if dataset_dir.exists():\n",
    "                    # Check for expected file patterns\n",
    "                    files_found = []\n",
    "                    for pattern in config['expected_files']:\n",
    "                        files_found.extend(list(dataset_dir.glob(pattern)))\n",
    "                    \n",
    "                    if files_found:\n",
    "                        result['available'] = True\n",
    "                        result['files_found'] = [str(f) for f in files_found[:5]]  # Limit for display\n",
    "                        result['data_dir'] = str(dataset_dir)\n",
    "                        result['file_count'] = len(files_found)\n",
    "                        break\n",
    "            \n",
    "            if result['available']:\n",
    "                break\n",
    "        \n",
    "        discovery_results[dataset_id] = result\n",
    "    \n",
    "    return discovery_results\n",
    "\n",
    "# Discover available datasets\n",
    "print('🔍 Discovering available EEG/RT datasets...')\n",
    "dataset_discovery = discover_datasets()\n",
    "\n",
    "print('\\n📋 Dataset Discovery Results:')\n",
    "available_datasets = []\n",
    "for dataset_id, result in dataset_discovery.items():\n",
    "    status = '✅ Available' if result['available'] else '❌ Not found'\n",
    "    print(f\"  {dataset_id.upper()}: {status}\")\n",
    "    if result['available']:\n",
    "        print(f\"    📁 Location: {result['data_dir']}\")\n",
    "        print(f\"    📄 Files: {result['file_count']} found\")\n",
    "        available_datasets.append(dataset_id)\n",
    "\n",
    "print(f\"\\n🎯 Available datasets for processing: {available_datasets}\")"
   ]
