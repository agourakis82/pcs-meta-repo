   "source": [
    "def validate_dataset_schema(df: pd.DataFrame, dataset_id: str) -> Dict[str, Any]:\n",
    "    \"\"\"\n",
    "    Validate dataset against WORD_EVENTS_SCHEMA.\n",
    "    \n",
    "    Args:\n",
    "        df: Dataset dataframe\n",
    "        dataset_id: Dataset identifier\n",
    "    \n",
    "    Returns:\n",
    "        Validation results dictionary\n",
    "    \"\"\"\n",
    "    validation_results = {\n",
    "        'dataset_id': dataset_id,\n",
    "        'schema_compliant': True,\n",
    "        'missing_required': [],\n",
    "        'present_optional': [],\n",
    "        'extra_columns': [],\n",
    "        'data_quality': {},\n",
    "        'warnings': [],\n",
    "        'errors': []\n",
    "    }\n",
    "    \n",
    "    try:\n",
    "        # Check required columns\n",
    "        required_cols = WORD_EVENTS_SCHEMA['required']\n",
    "        missing_required = [col for col in required_cols if col not in df.columns]\n",
    "        validation_results['missing_required'] = missing_required\n",
    "        \n",
    "        if missing_required:\n",
    "            validation_results['schema_compliant'] = False\n",
    "            validation_results['errors'].append(f\"Missing required columns: {missing_required}\")\n",
    "        \n",
    "        # Check optional columns\n",
    "        all_optional = WORD_EVENTS_SCHEMA['et_optional'] + WORD_EVENTS_SCHEMA['eeg_optional']\n",
    "        present_optional = [col for col in all_optional if col in df.columns]\n",
    "        validation_results['present_optional'] = present_optional\n",
    "        \n",
    "        # Identify extra columns\n",
    "        expected_cols = set(required_cols + all_optional)\n",
    "        extra_cols = [col for col in df.columns if col not in expected_cols]\n",
    "        validation_results['extra_columns'] = extra_cols\n",
    "        \n",
    "        # Data quality checks\n",
    "        quality = {}\n",
    "        \n",
    "        # Check for missing values in required columns\n",
    "        for col in required_cols:\n",
    "            if col in df.columns:\n",
    "                missing_pct = (df[col].isna().sum() / len(df)) * 100\n",
    "                quality[f'{col}_missing_pct'] = round(missing_pct, 2)\n",
    "                \n",
    "                if missing_pct > 10:  # More than 10% missing\n",
    "                    validation_results['warnings'].append(f\"High missing values in {col}: {missing_pct:.1f}%\")\n",
    "        \n",
    "        # Check data types and ranges\n",
    "        if 'word' in df.columns:\n",
    "            empty_words = (df['word'].str.len() == 0).sum()\n",
    "            quality['empty_words'] = empty_words\n",
    "            if empty_words > 0:\n",
    "                validation_results['warnings'].append(f\"Found {empty_words} empty words\")\n",
    "        \n",
    "        # Check subject coverage\n",
    "        if 'subject_id' in df.columns:\n",
    "            n_subjects = df['subject_id'].nunique()\n",
    "            quality['n_subjects'] = n_subjects\n",
    "            if n_subjects < 5:\n",
    "                validation_results['warnings'].append(f\"Low subject count: {n_subjects}\")\n",
    "        \n",
    "        # Check language consistency\n",
    "        if 'lang' in df.columns:\n",
    "            languages = df['lang'].value_counts().to_dict()\n",
    "            quality['languages'] = languages\n",
    "        \n",
    "        validation_results['data_quality'] = quality\n",
    "        \n",
    "        # Use project validation if available\n",
    "        try:\n",
    "            project_validation = validate_word_events(df, dataset_id)\n",
    "            validation_results['project_validation'] = project_validation\n",
    "        except Exception as e:\n",
    "            validation_results['warnings'].append(f\"Project validation failed: {e}\")\n",
    "        \n",
    "        return validation_results\n",
    "        \n",
    "    except Exception as e:\n",
    "        validation_results['schema_compliant'] = False\n",
    "        validation_results['errors'].append(f\"Validation error: {e}\")\n",
    "        return validation_results\n",
    "\n",
    "# Validate all loaded datasets\n",
    "print('🔍 Validating dataset schemas...')\n",
    "validation_results = {}\n",
    "\n",
    "for dataset_id, df in loaded_datasets.items():\n",
    "    print(f\"\\n📋 Validating {dataset_id.upper()}...\")\n",
    "    \n",
    "    results = validate_dataset_schema(df, dataset_id)\n",
    "    validation_results[dataset_id] = results\n",
    "    \n",
