    "def load_dataset_safely(dataset_id: str, config: Dict[str, Any]) -> Tuple[Optional[pd.DataFrame], Dict[str, Any]]:\n",
    "    \"\"\"\n",
    "    Safely load a dataset using its configured loader.\n",
    "    \n",
    "    Args:\n",
    "        dataset_id: Dataset identifier\n",
    "        config: Dataset configuration\n",
    "    \n",
    "    Returns:\n",
    "        Tuple of (dataframe, metadata)\n",
    "    \"\"\"\n",
    "    metadata = {\n",
    "        'dataset_id': dataset_id,\n",
    "        'success': False,\n",
    "        'error': None,\n",
    "        'rows': 0,\n",
    "        'columns': [],\n",
    "        'subjects': 0,\n",
    "        'processing_time': 0\n",
    "    }\n",
    "    \n",
    "    try:\n",
    "        start_time = datetime.now()\n",
    "        print(f\"🔄 Loading {config['name']}...\")\n",
    "        \n",
    "        # Import and execute loader\n",
    "        if dataset_id == 'zuco':\n",
    "            # Special handling for ZuCo\n",
    "            try:\n",
    "                from src.pcs_toolbox.zuco import load_all\n",
    "                df, qa_info = load_all(write_outputs=False)\n",
    "                \n",
    "                if df is not None and not df.empty:\n",
    "                    metadata['success'] = True\n",
    "                    metadata['rows'] = len(df)\n",
    "                    metadata['columns'] = list(df.columns)\n",
    "                    metadata['subjects'] = df['Subject'].nunique() if 'Subject' in df.columns else 0\n",
    "                    \n",
    "                    # Rename columns to match schema\n",
    "                    column_mapping = {\n",
    "                        'Subject': 'subject_id',\n",
    "                        'Dataset': 'doc_id',\n",
    "                        'SentenceID': 'sent_id',\n",
    "                        'w_pos': 'word_id',\n",
    "                        'token': 'word',\n",
    "                        'Task': 'task_id'\n",
    "                    }\n",
    "                    df = df.rename(columns=column_mapping)\n",
    "                    \n",
    "                    # Add missing required columns\n",
    "                    if 'lang' not in df.columns:\n",
    "                        df['lang'] = 'en'\n",
    "                    \n",
    "                    print(f\"  ✅ Loaded {len(df):,} rows from ZuCo\")\n",
    "                else:\n",
    "                    print(f\"  ⚠️ ZuCo loader returned empty data\")\n",
    "                    df = None\n",
    "                    \n",
    "            except Exception as e:\n",
    "                print(f\"  ❌ ZuCo loader failed: {e}\")\n",
    "                metadata['error'] = str(e)\n",
    "                df = None\n",
    "        \n",
    "        else:\n",
    "            # Standard loader handling\n",
    "            try:\n",
    "                module_path = config['loader_module']\n",
    "                function_name = config['loader_function']\n",
    "                \n",
    "                # Dynamic import\n",
    "                module = __import__(module_path, fromlist=[function_name])\n",
    "                loader_func = getattr(module, function_name)\n",
    "                \n",
    "                # Execute loader\n",
    "                if dataset_id in ['derco', 'geco', 'lpp', 'onestop']:\n",
    "                    output_path = loader_func()\n",
    "                    \n",
    "                    # Load the processed data\n",
    "                    if output_path and Path(output_path).exists():\n",
    "                        df = pd.read_parquet(output_path)\n",
    "                        metadata['success'] = True\n",
    "                        metadata['rows'] = len(df)\n",
    "                        metadata['columns'] = list(df.columns)\n",
    "                        metadata['subjects'] = df['subject_id'].nunique() if 'subject_id' in df.columns else 0\n",
    "                        print(f\"  ✅ Loaded {len(df):,} rows from {config['name']}\")\n",
    "                    else:\n",
    "                        print(f\"  ⚠️ {config['name']} loader did not produce output file\")\n",
    "                        df = None\n",
    "                else:\n",
    "                    print(f\"  ⚠️ Unknown dataset type: {dataset_id}\")\n",
    "                    df = None\n",
    "                    \n",
    "            except Exception as e:\n",
    "                print(f\"  ❌ {config['name']} loader failed: {e}\")\n",
    "                metadata['error'] = str(e)\n",
    "                df = None\n",
    "        \n",
    "        # Calculate processing time\n",
    "        processing_time = (datetime.now() - start_time).total_seconds()\n",
    "        metadata['processing_time'] = processing_time\n",
    "        \n",
    "        return df, metadata\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"  ❌ Critical error loading {config['name']}: {e}\")\n",
    "        metadata['error'] = str(e)\n",
    "        return None, metadata\n",
    "\n",
    "# Load all available datasets\n",
    "print('🚀 Starting data loading process...')\n",
    "loaded_datasets = {}\n",
    "loading_metadata = {}\n",
    "\n",
    "for dataset_id in available_datasets:\n",
    "    if RUN_MODE == 'sample' and len(loaded_datasets) >= 2:\n",
    "        print(f\"⏭️ Skipping {dataset_id} in sample mode (limit: 2 datasets)\")\n",
    "        continue\n",
    "        \n",
    "    config = DATASETS_CONFIG[dataset_id]\n",
    "    df, metadata = load_dataset_safely(dataset_id, config)\n",
    "    \n",
    "    if df is not None and not df.empty:\n",
    "        loaded_datasets[dataset_id] = df\n",
    "    \n",
    "    loading_metadata[dataset_id] = metadata\n",
    "\n",
    "print(f\"\\n📊 Loading Summary: {len(loaded_datasets)} datasets successfully loaded\")\n",
    "for dataset_id, metadata in loading_metadata.items():\n",
    "    status = '✅' if metadata['success'] else '❌'\n",
    "    print(f\"  {status} {dataset_id.upper()}: {metadata['rows']:,} rows, {metadata['subjects']} subjects\")\n",
    "    if metadata['error']:\n",
    "        print(f\"    Error: {metadata['error']}\")"
