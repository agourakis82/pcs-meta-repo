    "G_theory.add_nodes_from(confounders + treatments + mediators + outcomes)\n",
    "\n",
    "# Add edges representing causal relationships\n",
    "causal_edges = [\n",
    "    # Confounders affect everything\n",
    "    ('Word_Freq', 'Entropy'), ('Word_Freq', 'Curvature'), ('Word_Freq', 'Coherence'),\n",
    "    ('Word_Freq', 'FFD'), ('Word_Freq', 'GD'), ('Word_Freq', 'TRT'),\n",
    "    ('Word_Len', 'FFD'), ('Word_Len', 'GD'), ('Word_Len', 'TRT'),\n",
    "    \n",
    "    # KEC → EEG (mediation pathway)\n",
    "    ('Entropy', 'Theta'), ('Curvature', 'Alpha'), ('Coherence', 'Beta'),\n",
    "    \n",
