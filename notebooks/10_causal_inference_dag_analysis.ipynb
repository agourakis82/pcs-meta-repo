    "    ('Entropy', 'FFD'), ('Curvature', 'GD'), ('Coherence', 'TRT')\n",
    "]\n",
    "\n",
    "G_theory.add_edges_from(causal_edges)\n",
    "\n",
    "# Position nodes in layers\n",
    "pos_theory = {\n",
    "    # Confounders (left)\n",
    "    'Word_Freq': (0, 2), 'Word_Len': (0, 1), 'Sent_Pos': (0, 0),\n",
    "    # KEC metrics (treatments)\n",
    "    'Entropy': (2, 2.5), 'Curvature': (2, 1.5), 'Coherence': (2, 0.5),\n",
    "    # EEG (mediators)\n",
    "    'Theta': (4, 2.5), 'Alpha': (4, 1.5), 'Beta': (4, 0.5),\n",
    "    # Reading times (outcomes)\n",
    "    'FFD': (6, 2), 'GD': (6, 1), 'TRT': (6, 0)\n",
