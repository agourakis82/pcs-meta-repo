    "## 5. Mediation Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Comprehensive mediation analysis\n",
    "def mediation_analysis(data, treatment, mediator, outcome, covariates=None, n_bootstrap=1000):\n",
    "    \"\"\"\n",
