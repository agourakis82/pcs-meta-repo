    "nx.draw_networkx_nodes(G_theory, pos_theory, nodelist=treatments, \n",
    "                      node_color='lightblue', node_size=2000, alpha=0.8, ax=ax1)\n",
    "nx.draw_networkx_nodes(G_theory, pos_theory, nodelist=mediators, \n",
    "                      node_color='lightgreen', node_size=2000, alpha=0.8, ax=ax1)\n",
    "nx.draw_networkx_nodes(G_theory, pos_theory, nodelist=outcomes, \n",
    "                      node_color='lightyellow', node_size=2000, alpha=0.8, ax=ax1)\n",
    "\n",
    "nx.draw_networkx_edges(G_theory, pos_theory, edge_color='gray', \n",
    "                      arrows=True, arrowsize=20, arrowstyle='->', ax=ax1)\n",
    "nx.draw_networkx_labels(G_theory, pos_theory, font_size=9, font_weight='bold', ax=ax1)\n",
    "\n",
    "ax1.set_title('Theoretical Causal Graph\\nKEC → Neural → Behavioral', \n",
    "             fontsize=14, fontweight='bold')\n",
    "ax1.axis('off')\n",
    "\n",
    "# Graph 2: Empirical Correlation Network\n",
    "# Calculate correlations between key variables\n",
    "key_vars = ['kec_entropy', 'kec_curvature', 'kec_coherence', \n",
    "           'theta_power', 'alpha_power', 'beta_power',\n",
    "           'first_fixation_duration', 'gaze_duration', 'total_reading_time']\n",
    "\n",
    "corr_matrix = df[key_vars].corr()\n",
    "\n",
    "# Create correlation network (only strong correlations)\n",
    "G_empirical = nx.Graph()\n",
    "threshold = 0.15  # Only show correlations > 0.15\n",
    "\n",
    "var_names = {\n",
    "    'kec_entropy': 'Entropy', 'kec_curvature': 'Curvature', 'kec_coherence': 'Coherence',\n",
