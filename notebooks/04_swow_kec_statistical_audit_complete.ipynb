    "def assess_data_availability() -> Dict[str, Any]:\n",
    "    \"\"\"\n",
    "    Assess the availability and basic properties of loaded datasets.\n",
    "    \n",
    "    Returns:\n",
    "        Dictionary with assessment results\n",
    "    \"\"\"\n",
    "    assessment = {\n",
    "        'timestamp': datetime.now().isoformat(),\n",
    "        'datasets': {},\n",
    "        'pipeline_status': 'UNKNOWN'\n",
    "    }\n",
    "    \n",
    "    # Assess each dataset\n",
    "    for name, df in datasets.items():\n",
    "        if df.empty:\n",
    "            assessment['datasets'][name] = {\n",
    "                'available': False,\n",
    "                'shape': (0, 0),\n",
    "                'columns': []\n",
    "            }\n",
    "        else:\n",
    "            assessment['datasets'][name] = {\n",
    "                'available': True,\n",
    "                'shape': df.shape,\n",
    "                'columns': list(df.columns),\n",
    "                'memory_usage_mb': df.memory_usage(deep=True).sum() / 1024**2,\n",
    "                'dtypes': df.dtypes.value_counts().to_dict()\n",
    "            }\n",
    "    \n",
    "    # Determine pipeline status\n",
    "    required_datasets = ['zuco', 'kec', 'merged']\n",
    "    available_datasets = [name for name in required_datasets \n",
    "                         if assessment['datasets'].get(name, {}).get('available', False)]\n",
    "    \n",
    "    if len(available_datasets) == len(required_datasets):\n",
    "        assessment['pipeline_status'] = 'COMPLETE'\n",
    "    elif len(available_datasets) >= 2:\n",
    "        assessment['pipeline_status'] = 'PARTIAL'\n",
    "    else:\n",
    "        assessment['pipeline_status'] = 'INCOMPLETE'\n",
    "    \n",
    "    return assessment\n",
    "\n",
    "# Perform initial assessment\n",
    "initial_assessment = assess_data_availability()\n",
    "\n",
    "print(f\"📋 Pipeline Status: {initial_assessment['pipeline_status']}\")\n",
    "print(\"\\n📊 Dataset Summary:\")\n",
    "for name, info in initial_assessment['datasets'].items():\n",
    "    if info['available']:\n",
    "        print(f\"  ✅ {name}: {info['shape'][0]:,} rows × {info['shape'][1]} cols ({info['memory_usage_mb']:.1f} MB)\")\n",
    "    else:\n",
    "        print(f\"  ❌ {name}: Not available\")\n",
    "\n",
    "# Save initial assessment\n",
    "with open(AUDIT_OUT / 'initial_assessment.json', 'w') as f:\n",
    "    json.dump(initial_assessment, f, indent=2, default=str)\n",
    "\n",
    "print(f\"\\n💾 Initial assessment saved to: {AUDIT_OUT / 'initial_assessment.json'}\")"
   ]
