    "def norm_token(s: str) -> str:\n",
    "    \"\"\"\n",
    "    Normalize token for consistent matching (replicates tools/merge_zuco_kec.py logic).\n",
    "    \n",
    "    Args:\n",
    "        s: Input string\n",
    "        \n",
    "    Returns:\n",
    "        Normalized token string\n",
    "    \"\"\"\n",
    "    s = s if isinstance(s, str) else ''\n",
    "    s = s.lower()\n",
    "    return re.sub(r\"[\\W_]+\", \"\", s)\n",
    "\n",
    "def bh_fdr_correction(p_values: pd.Series, alpha: float = 0.05) -> pd.Series:\n",
    "    \"\"\"\n",
    "    Apply Benjamini-Hochberg FDR correction (replicates tools/validate_hstar.py logic).\n",
    "    \n",
    "    Args:\n",
    "        p_values: Series of p-values\n",
    "        alpha: Significance level\n",
    "        \n",
    "    Returns:\n",
    "        Series of FDR-corrected q-values\n",
    "    \"\"\"\n",
    "    m = len(p_values)\n",
    "    if m == 0:\n",
    "        return pd.Series([], dtype=float)\n",
    "    \n",
    "    order = p_values.values.argsort()\n",
    "    ranks = pd.Series(range(1, m+1), index=p_values.index[order])\n",
    "    adj = pd.Series(p_values.values[order] * m / ranks.values)\n",
    "    q = adj.cummin()[::-1][::-1].clip(upper=1.0).values\n",
    "    out = pd.Series(1.0, index=p_values.index)\n",
    "    out.iloc[order] = q\n",
    "    return out.clip(upper=1.0)\n",
    "\n",
    "def detect_outliers(data: pd.Series, method: str = 'zscore', threshold: float = 3.0) -> pd.Series:\n",
    "    \"\"\"\n",
    "    Detect outliers in a data series.\n",
    "    \n",
    "    Args:\n",
    "        data: Input data series\n",
    "        method: Outlier detection method ('zscore' or 'iqr')\n",
    "        threshold: Threshold for outlier detection\n",
    "        \n",
    "    Returns:\n",
    "        Boolean series indicating outliers\n",
    "    \"\"\"\n",
    "    if method == 'zscore':\n",
    "        z_scores = np.abs(stats.zscore(data.dropna()))\n",
    "        outliers = pd.Series(False, index=data.index)\n",
    "        outliers.loc[data.dropna().index] = z_scores > threshold\n",
    "        return outliers\n",
    "    \n",
    "    elif method == 'iqr':\n",
    "        Q1 = data.quantile(0.25)\n",
    "        Q3 = data.quantile(0.75)\n",
    "        IQR = Q3 - Q1\n",
    "        lower_bound = Q1 - threshold * IQR\n",
    "        upper_bound = Q3 + threshold * IQR\n",
    "        return (data < lower_bound) | (data > upper_bound)\n",
    "    \n",
    "    else:\n",
    "        raise ValueError(f\"Unknown outlier detection method: {method}\")\n",
    "\n",
    "print(\"✅ Utility functions defined\")"
   ]
