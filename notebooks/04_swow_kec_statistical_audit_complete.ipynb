    "def audit_kec_metrics() -> Dict[str, Any]:\n",
    "    \"\"\"\n",
    "    Audit the KEC metrics computation for validity and consistency.\n",
    "    \n",
    "    Returns:\n",
    "        Dictionary with audit results\n",
    "    \"\"\"\n",
    "    audit_results = {\n",
    "        'timestamp': datetime.now().isoformat(),\n",
    "        'metrics_available': False,\n",
    "        'validation_results': {},\n",
    "        'statistics': {},\n",
    "        'issues': []\n",
    "    }\n",
    "    \n",
    "    if datasets['kec'].empty:\n",
    "        audit_results['issues'].append(\"KEC metrics dataset not available\")\n",
    "        return audit_results\n",
    "    \n",
    "    kec_df = datasets['kec'].copy()\n",
    "    audit_results['metrics_available'] = True\n",
    "    \n",
    "    # Check expected columns\n",
    "    expected_cols = ['entropy', 'curvature', 'coherence']\n",
    "    available_cols = [col for col in expected_cols if col in kec_df.columns]\n",
    "    missing_cols = [col for col in expected_cols if col not in kec_df.columns]\n",
    "    \n",
    "    if missing_cols:\n",
    "        audit_results['issues'].append(f\"Missing KEC columns: {missing_cols}\")\n",
    "    \n",
    "    # Validate each available metric\n",
    "    for metric in available_cols:\n",
    "        values = kec_df[metric].dropna()\n",
    "        \n",
    "        validation = {\n",
    "            'total_values': len(kec_df),\n",
    "            'valid_values': len(values),\n",
    "            'missing_count': kec_df[metric].isna().sum(),\n",
    "            'missing_pct': (kec_df[metric].isna().sum() / len(kec_df)) * 100,\n",
    "            'statistics': {\n",
    "                'mean': float(values.mean()) if len(values) > 0 else None,\n",
    "                'std': float(values.std()) if len(values) > 0 else None,\n",
    "                'min': float(values.min()) if len(values) > 0 else None,\n",
    "                'max': float(values.max()) if len(values) > 0 else None,\n",
    "                'median': float(values.median()) if len(values) > 0 else None,\n",
    "                'q25': float(values.quantile(0.25)) if len(values) > 0 else None,\n",
    "                'q75': float(values.quantile(0.75)) if len(values) > 0 else None\n",
    "            },\n",
    "            'range_issues': []\n",
    "        }\n",
    "        \n",
    "        # Check value ranges\n",
    "        if len(values) > 0:\n",
    "            if metric == 'entropy':\n",
    "                if values.min() < 0:\n",
    "                    validation['range_issues'].append(\"Negative entropy values found\")\n",
    "                if values.max() > 10:  # Reasonable upper bound\n",
    "                    validation['range_issues'].append(\"Unusually high entropy values (>10)\")\n",
    "            \n",
    "            elif metric == 'coherence':\n",
    "                if values.min() < -1 or values.max() > 1:\n",
    "                    validation['range_issues'].append(\"Coherence values outside expected range [-1, 1]\")\n",
    "            \n",
    "            # Check for infinite values\n",
    "            if np.isinf(values).any():\n",
    "                validation['range_issues'].append(\"Infinite values detected\")\n",
    "        \n",
    "        audit_results['validation_results'][metric] = validation\n",
    "    \n",
    "    # Overall statistics\n",
    "    audit_results['statistics'] = {\n",
    "        'total_nodes': len(kec_df),\n",
    "        'complete_cases': len(kec_df.dropna(subset=available_cols)) if available_cols else 0,\n",
    "        'complete_cases_pct': (len(kec_df.dropna(subset=available_cols)) / len(kec_df) * 100) if available_cols and len(kec_df) > 0 else 0,\n",
    "        'available_metrics': available_cols,\n",
    "        'missing_metrics': missing_cols\n",
    "    }\n",
    "    \n",
    "    return audit_results\n",
    "\n",
    "# Perform KEC metrics audit\n",
    "print(\"🔍 Auditing KEC metrics computation...\")\n",
    "kec_audit = audit_kec_metrics()\n",
    "\n",
    "if kec_audit['metrics_available']:\n",
    "    print(f\"✅ KEC metrics available: {kec_audit['statistics']['available_metrics']}\")\n",
    "    print(f\"📊 Total nodes: {kec_audit['statistics']['total_nodes']:,}\")\n",
    "    print(f\"📊 Complete cases: {kec_audit['statistics']['complete_cases']:,} ({kec_audit['statistics']['complete_cases_pct']:.1f}%)\")\n",
    "    \n",
    "    if kec_audit['issues']:\n",
    "        print(\"\\n⚠️ Issues found:\")\n",
    "        for issue in kec_audit['issues']:\n",
    "            print(f\"  - {issue}\")\n",
    "else:\n",
    "    print(\"❌ KEC metrics not available for audit\")\n",
    "\n",
    "# Save KEC audit results\n",
    "with open(AUDIT_OUT / 'kec_metrics_audit.json', 'w') as f:\n",
    "    json.dump(kec_audit, f, indent=2, default=str)\n",
    "\n",
    "print(f\"\\n💾 KEC audit results saved to: {AUDIT_OUT / 'kec_metrics_audit.json'}\")"
   ]
  },
