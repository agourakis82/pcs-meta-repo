    "def audit_data_integration() -> Dict[str, Any]:\n",
    "    \"\"\"\n",
    "    Audit the SWOW-ZuCo data integration pipeline.\n",
    "    \n",
    "    Returns:\n",
    "        Dictionary with integration audit results\n",
    "    \"\"\"\n",
    "    audit_results = {\n",
    "        'timestamp': datetime.now().isoformat(),\n",
    "        'integration_available': False,\n",
    "        'merge_statistics': {},\n",
    "        'coverage_analysis': {},\n",
    "        'token_normalization': {},\n",
    "        'issues': []\n",
    "    }\n",
    "    \n",
    "    # Check if we have the necessary datasets\n",
    "    if datasets['zuco'].empty:\n",
    "        audit_results['issues'].append(\"ZuCo dataset not available\")\n",
    "    if datasets['kec'].empty:\n",
    "        audit_results['issues'].append(\"KEC dataset not available\")\n",
    "    if datasets['merged'].empty:\n",
    "        audit_results['issues'].append(\"Merged dataset not available\")\n",
    "    \n",
    "    if datasets['merged'].empty:\n",
    "        return audit_results\n",
    "    \n",
    "    audit_results['integration_available'] = True\n",
    "    merged_df = datasets['merged'].copy()\n",
    "    \n",
    "    # Basic merge statistics\n",
    "    audit_results['merge_statistics'] = {\n",
    "        'total_rows': len(merged_df),\n",
    "        'total_columns': len(merged_df.columns),\n",
    "        'memory_usage_mb': merged_df.memory_usage(deep=True).sum() / 1024**2\n",
    "    }\n",
    "    \n",
    "    # Check for key columns\n",
    "    key_columns = {\n",
    "        'token_norm': 'token_norm' in merged_df.columns,\n",
    "        'entropy': 'entropy' in merged_df.columns,\n",
    "        'curvature': 'curvature' in merged_df.columns,\n",
    "        'coherence': 'coherence' in merged_df.columns,\n",
    "        'subject_id': any(col in merged_df.columns for col in ['Subject', 'subject', 'subject_id']),\n",
    "        'reading_measures': any(col in merged_df.columns for col in ['TRT', 'FFD', 'GD', 'GPT', 'duration_ms'])\n",
