    "def load_swow_data_multilingual() -> Dict[str, pd.DataFrame]:\n",
    "    \"\"\"\n",
    "    Load SWOW data for all supported languages.\n",
    "    \n",
    "    Returns:\n",
    "        Dictionary mapping language codes to SWOW DataFrames\n",
    "    \"\"\"\n",
    "    swow_data = {}\n",
    "    \n",
    "    for lang_code, lang_info in LANGUAGES.items():\n",
    "        logger.info(f\"Loading SWOW data for {lang_info['name']} ({lang_code})\")\n",
    "        \n",
    "        # Try multiple potential paths for SWOW data\n",
    "        potential_paths = [\n",
    "            DATA / 'raw_public' / 'swow' / lang_code / f'swow_{lang_code}.csv',\n",
    "            DATA / 'processed' / 'swow' / f'swow_{lang_code}_processed.csv',\n",
    "            DATA / f'{lang_code}' / 'swow.csv',\n",
    "            PROCESSED / 'swow' / f'{lang_code}_edges.csv'\n",
    "        ]\n",
    "        \n",
    "        loaded = False\n",
    "        for path in potential_paths:\n",
    "            if path.exists():\n",
    "                try:\n",
    "                    df = pd.read_csv(path)\n",
    "                    # Standardize column names\n",
    "                    if 'cue' in df.columns and 'response' in df.columns:\n",
    "                        df = df.rename(columns={'cue': 'word1', 'response': 'word2'})\n",
    "                    elif 'source' in df.columns and 'target' in df.columns:\n",
    "                        df = df.rename(columns={'source': 'word1', 'target': 'word2'})\n",
    "                    \n",
    "                    df['language'] = lang_code\n",
    "                    swow_data[lang_code] = df\n",
    "                    logger.info(f\"✅ Loaded {len(df)} SWOW edges for {lang_code} from {path}\")\n",
    "                    loaded = True\n",
    "                    break\n",
    "                except Exception as e:\n",
    "                    logger.warning(f\"Failed to load {path}: {e}\")\n",
    "        \n",
    "        if not loaded:\n",
    "            logger.warning(f\"⚠️  No SWOW data found for {lang_code}\")\n",
    "            # Create synthetic sample for demonstration\n",
    "            sample_data = pd.DataFrame({\n",
    "                'word1': ['cat', 'dog', 'house', 'tree', 'book'],\n",
    "                'word2': ['animal', 'pet', 'home', 'plant', 'read'],\n",
    "                'weight': [0.8, 0.9, 0.7, 0.6, 0.85],\n",
    "                'language': [lang_code] * 5\n",
    "            })\n",
    "            swow_data[lang_code] = sample_data\n",
    "            logger.info(f\"📝 Created synthetic SWOW sample for {lang_code}\")\n",
    "    \n",
    "    return swow_data\n",
    "\n",
    "# Execute data loading\n",
    "print(\"🔄 Loading multilingual SWOW data...\")\n",
    "swow_multilingual = load_swow_data_multilingual()\n",
    "\n",
    "# Summary statistics\n",
    "print(\"\\n📊 SWOW Data Loading Summary:\")\n",
    "print(\"=\" * 50)\n",
    "for lang_code in LANGUAGES.keys():\n",
    "    swow_count = len(swow_multilingual.get(lang_code, pd.DataFrame()))\n",
    "    print(f\"{LANGUAGES[lang_code]['name']:>10} ({lang_code}): {swow_count:>6} edges\")"
   ]
