    "def integrate_all_data() -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Integrate SWOW, KEC, and EEG/RT data into a unified dataset.\n",
    "    \n",
    "    Returns:\n",
    "        Integrated DataFrame with all modalities\n",
    "    \"\"\"\n",
    "    logger.info(\"Starting comprehensive data integration...\")\n",
    "    \n",
    "    # Combine all EEG/RT datasets\n",
    "    all_eeg_rt = []\n",
    "    for dataset_name, df in eeg_rt_multilingual.items():\n",
    "        df_copy = df.copy()\n",
    "        df_copy['source_dataset'] = dataset_name\n",
    "        all_eeg_rt.append(df_copy)\n",
    "    \n",
    "    combined_eeg_rt = pd.concat(all_eeg_rt, ignore_index=True)\n",
    "    logger.info(f\"Combined EEG/RT data: {len(combined_eeg_rt)} records\")\n",
    "    \n",
    "    # Combine all KEC metrics\n",
    "    all_kec = []\n",
    "    for lang_code, df in kec_multilingual.items():\n",
    "        df_copy = df.copy()\n",
    "        df_copy['kec_language'] = lang_code\n",
    "        all_kec.append(df_copy)\n",
