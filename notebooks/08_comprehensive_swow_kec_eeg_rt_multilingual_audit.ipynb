    "def load_eeg_rt_data() -> Dict[str, pd.DataFrame]:\n",
    "    \"\"\"\n",
    "    Load EEG/RT datasets from the standardized pipeline.\n",
    "    \n",
    "    Returns:\n",
    "        Dictionary mapping dataset names to DataFrames\n",
    "    \"\"\"\n",
    "    eeg_rt_data = {}\n",
    "    \n",
    "    # Dataset configurations\n",
    "    datasets_config = {\n",
    "        'zuco_v1': {\n",
    "            'paths': [\n",
    "                PROCESSED / 'zuco' / 'zuco_v1_processed.csv',\n",
    "                DATA / 'processed' / 'zuco_v1.csv',\n",
    "                'outputs/processed/zuco1_processed.csv'\n",
    "            ],\n",
    "            'language': 'en',\n",
    "            'modalities': ['eeg', 'et']\n",
    "        },\n",
    "        'zuco_v2': {\n",
    "            'paths': [\n",
    "                PROCESSED / 'zuco' / 'zuco_v2_processed.csv',\n",
    "                DATA / 'processed' / 'zuco_v2.csv',\n",
    "                'outputs/processed/zuco2_processed.csv'\n",
    "            ],\n",
    "            'language': 'en',\n",
    "            'modalities': ['eeg', 'et']\n",
    "        },\n",
    "        'derco': {\n",
    "            'paths': [\n",
    "                PROCESSED / 'derco' / 'derco_processed.csv',\n",
    "                DATA / 'processed' / 'derco.csv'\n",
    "            ],\n",
    "            'language': 'en',\n",
    "            'modalities': ['eeg']\n",
    "        },\n",
    "        'geco': {\n",
    "            'paths': [\n",
    "                PROCESSED / 'geco' / 'geco_processed.csv',\n",
    "                DATA / 'processed' / 'geco.csv'\n",
    "            ],\n",
    "            'language': 'en',\n",
    "            'modalities': ['et']\n",
    "        },\n",
    "        'onestop': {\n",
    "            'paths': [\n",
    "                PROCESSED / 'onestop' / 'onestop_processed.csv',\n",
    "                DATA / 'processed' / 'onestop.csv'\n",
    "            ],\n",
    "            'language': 'en',\n",
    "            'modalities': ['et']\n",
    "        }\n",
    "    }\n",
    "    \n",
    "    for dataset_name, config in datasets_config.items():\n",
    "        logger.info(f\"Loading {dataset_name} dataset...\")\n",
    "        \n",
    "        loaded = False\n",
    "        for path in config['paths']:\n",
    "            path_obj = Path(path)\n",
    "            if path_obj.exists():\n",
    "                try:\n",
    "                    df = pd.read_csv(path_obj)\n",
    "                    \n",
    "                    # Add metadata\n",
    "                    df['dataset'] = dataset_name\n",
    "                    df['language'] = config['language']\n",
    "                    df['modalities'] = ','.join(config['modalities'])\n",
    "                    \n",
    "                    # Standardize token column\n",
    "                    if 'word' in df.columns:\n",
    "                        df['token_norm'] = df['word'].str.lower().str.replace(r'[^a-zA-Z0-9]', '', regex=True)\n",
    "                    elif 'token' in df.columns:\n",
    "                        df['token_norm'] = df['token'].str.lower().str.replace(r'[^a-zA-Z0-9]', '', regex=True)\n",
    "                    \n",
    "                    eeg_rt_data[dataset_name] = df\n",
    "                    logger.info(f\"✅ Loaded {dataset_name}: {len(df)} records from {path_obj}\")\n",
    "                    loaded = True\n",
    "                    break\n",
    "                    \n",
    "                except Exception as e:\n",
    "                    logger.warning(f\"Failed to load {path_obj}: {e}\")\n",
    "        \n",
    "        if not loaded:\n",
